# Where the browser finds each service. These are the defaults; copy to .env to change them.
# exchange-api: REST (orders, order book, traders, trades)
VITE_EXCHANGE_API_URL=http://127.0.0.1:8001
# market-data: real stock prices
VITE_STOCK_API_URL=http://127.0.0.1:8000
# exchange-api: live engine numbers and controls (WebSocket)
VITE_TELEMETRY_URL=ws://127.0.0.1:8001/ws/telemetry
